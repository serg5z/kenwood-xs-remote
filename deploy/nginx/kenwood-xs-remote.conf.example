# Replace all __PLACEHOLDERS__ before enabling this site.
# Install as a server block inside nginx's http context (for example,
# /etc/nginx/sites-available/kenwood-xs-remote).
# No HTTP/port 80 listener is provided: use https:// explicitly.
server {
    listen __LAN_IPV4__:443 ssl;
    server_name __LAN_HOSTNAME__;
    server_tokens off;

    ssl_certificate __SERVER_CERT_PATH__;
    ssl_certificate_key __SERVER_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:KENWOOD_XS:1m;
    ssl_session_timeout 10m;

    auth_basic "Kenwood XS Remote";
    auth_basic_user_file __PASSWORD_FILE_PATH__;

    # Reject unexpected Host values, including direct-IP requests.
    if ($host != "__LAN_HOSTNAME__") { return 421; }

    location / {
        proxy_pass http://unix:/run/kenwood-gateway.sock:;
        proxy_set_header Host __LAN_HOSTNAME__;
        proxy_set_header X-Forwarded-Proto https;
        # The gateway does not need to receive the Basic Auth password.
        proxy_set_header Authorization "";
        # Overwrite any client-supplied identity after nginx authentication.
        proxy_set_header X-Kenwood-Authenticated-User $remote_user;
        proxy_connect_timeout 2s;
        # Above the Gateway's worst case for leaving CD (1 s STATUS + two 3 s
        # replies) and below the browser's 9 s source timeout.
        proxy_read_timeout 8s;
        proxy_next_upstream off;
    }
}
