[Unit]
Description=Kenwood XS Remote read-only Web Gateway
# The matching .socket unit passes the only HTTP listener.
BindsTo=kenwood-xs-gateway.socket
After=kenwood-xs-gateway.socket

[Service]
Type=simple
User=__GATEWAY_USER__
Group=__GATEWAY_GROUP__
WorkingDirectory=__REPO_DIR__
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __REPO_DIR__/xs8_gateway.py --systemd-socket --nginx-uid __NGINX_WORKER_UID__
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateDevices=true
# Do not isolate /tmp: xs8-service uses /tmp/kenwood-xs8.sock by default.
PrivateTmp=false
RestrictAddressFamilies=AF_UNIX
